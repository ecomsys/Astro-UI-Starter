---
import {
    NavigationMenu,
    NavigationMenuList,
    NavigationMenuItem,
    NavigationMenuTrigger,
    NavigationMenuContent,
    NavigationMenuLink,
} from "../../components/ui/navigation-menu";
import Button from "../../components/ui/Button.astro";
import { Cloud, Server, Database, Zap, BookOpen, LifeBuoy, Users, Briefcase, ArrowRight } from "@lucide/astro";
---

<!-- НАСТОЯЩИЙ ХЕДЕР САЙТА -->
<header class="w-full border-b bg-card/50 backdrop-blur sticky top-0 z-40">
    <div class="max-w-6xl mx-auto px-4 flex h-16 items-center justify-between">
        <!-- Логотип -->
        <div class="font-bold text-lg">VIRGO UI</div>

        <!-- МЕГА-МЕНЮ (По центру) -->
        <NavigationMenu>
            <NavigationMenuList class="gap-1">
                <!-- 1. МЕГА-МЕНЮ: Продукты (Привязка к левому краю - align="start") -->
                <NavigationMenuItem align="start" sideOffset={12}>
                    <NavigationMenuTrigger>Продукты</NavigationMenuTrigger>
                    <NavigationMenuContent class="w-150 p-0">
                        <div class="grid grid-cols-[1fr_12.5rem] gap-0">
                            <!-- Левая колонка: Ссылки с иконками и описанием -->
                            <div class="p-4 grid grid-cols-2 gap-2">
                                <NavigationMenuLink href="#" class="flex-col items-start gap-1 hover:bg-muted">
                                    <div class="flex items-center gap-2">
                                        <Cloud class="size-5 text-primary" />
                                        <span class="font-medium">Cloud Hosting</span>
                                    </div>
                                    <p class="text-xs text-muted-foreground font-normal">
                                        Масштабируемый хостинг для ваших проектов
                                    </p>
                                </NavigationMenuLink>

                                <NavigationMenuLink href="#" class="flex-col items-start gap-1 hover:bg-muted">
                                    <div class="flex items-center gap-2">
                                        <Server class="size-5 text-primary" />
                                        <span class="font-medium">Dedicated Servers</span>
                                    </div>
                                    <p class="text-xs text-muted-foreground font-normal">
                                        Выделенные мощности под ключ
                                    </p>
                                </NavigationMenuLink>

                                <NavigationMenuLink href="#" class="flex-col items-start gap-1 hover:bg-muted">
                                    <div class="flex items-center gap-2">
                                        <Database class="size-5 text-primary" />
                                        <span class="font-medium">Managed DB</span>
                                    </div>
                                    <p class="text-xs text-muted-foreground font-normal">Базы данных с авто-бэкапами</p>
                                </NavigationMenuLink>

                                <NavigationMenuLink href="#" class="flex-col items-start gap-1 hover:bg-muted">
                                    <div class="flex items-center gap-2">
                                        <Zap class="size-5 text-primary" />
                                        <span class="font-medium">Edge Functions</span>
                                    </div>
                                    <p class="text-xs text-muted-foreground font-normal">Serverless вычисления</p>
                                </NavigationMenuLink>
                            </div>

                            <!-- Правая колонка: Промо-баннер -->
                            <div class="bg-primary/10 p-4 flex flex-col gap-2 justify-center border-l">
                                <h3 class="font-bold text-primary">Новинка!</h3>
                                <p class="text-xs text-muted-foreground">
                                    Попробуйте наш новый AI-ассистент для управления серверами.
                                </p>
                                <Button size="sm" class="w-full mt-2">
                                    Try Now <ArrowRight class="size-4" />
                                </Button>
                            </div>
                        </div>
                    </NavigationMenuContent>
                </NavigationMenuItem>

                <!-- 2. ОБЫЧНОЕ МЕНЮ: Ресурсы (По центру - align="center") -->
                <NavigationMenuItem align="center" sideOffset={12}>
                    <NavigationMenuTrigger>Ресурсы</NavigationMenuTrigger>
                    <NavigationMenuContent class="w-64">
                        <NavigationMenuLink href="#"><BookOpen /> Документация</NavigationMenuLink>
                        <NavigationMenuLink href="#"><LifeBuoy /> Поддержка</NavigationMenuLink>
                        <NavigationMenuLink href="#"><Server /> Статус серверов</NavigationMenuLink>
                    </NavigationMenuContent>
                </NavigationMenuItem>

                <!-- 3. МЕНЮ С ГРУППИРОВКОЙ: Компания (Привязка к правому краю - align="end") -->
                <NavigationMenuItem align="end" sideOffset={12}>
                    <NavigationMenuTrigger>Компания</NavigationMenuTrigger>
                    <NavigationMenuContent class="w-72">
                        <div class="p-2">
                            <p class="text-xs font-medium text-muted-foreground mb-1">О нас</p>
                            <NavigationMenuLink href="#"><Users /> Наша команда</NavigationMenuLink>
                            <NavigationMenuLink href="#"><Briefcase /> Вакансии</NavigationMenuLink>
                        </div>
                        <div class="p-2 border-t mt-1">
                            <p class="text-xs font-medium text-muted-foreground mb-1">Контакты</p>
                            <NavigationMenuLink href="#">Связаться с нами</NavigationMenuLink>
                        </div>
                    </NavigationMenuContent>
                </NavigationMenuItem>

                <!-- 4. Обычная ссылка (Без дропдауна) -->
                <NavigationMenuItem class="flex items-center">
                    <a
                        href="#"
                        class="inline-flex h-9 items-center px-3 text-sm font-medium hover:bg-muted rounded-lg transition-colors"
                        >Цены</a
                    >
                </NavigationMenuItem>
            </NavigationMenuList>
        </NavigationMenu>

        <!-- Кнопки справа -->
        <div class="flex items-center gap-2">
            <Button variant="ghost" size="sm">Войти</Button>
            <Button size="sm">Регистрация</Button>
        </div>
    </div>
</header>

<!-- Контент страницы, чтобы был скролл -->
<div class="max-w-6xl mx-auto px-4 py-20">
    <h1 class="text-4xl font-bold">Добро пожаловать на сайт</h1>
    <p class="mt-4 text-muted-foreground">
        Наведи мышку на пункты меню в шапке, чтобы увидеть мега-меню в действии. Попробуй перевести курсор с кнопки на
        само меню — оно не закроется. Попробуй кликнуть по ссылке внутри — меню закроется само.
    </p>
</div>
