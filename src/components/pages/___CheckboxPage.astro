---
import Checkbox from "../ui/Checkbox.astro";
import Label from "../ui/Label.astro";
import Button from "../ui/Button.astro";
---

<div class="flex flex-col gap-4">
    <!-- Обычная галочка -->
    <div class="flex items-center gap-3">
        <Checkbox id="terms" />
        <Label for="terms">Я согласен с правилами сайта</Label>
    </div>

    <!-- Включенная по умолчанию -->
    <div class="flex items-center gap-3">
        <Checkbox id="newsletter" checked />
        <Label for="newsletter">Подписаться на рассылку</Label>
    </div>

    <!-- Заблокированная -->
    <div class="flex items-center gap-3">
        <Checkbox id="locked" disabled />
        <Label for="locked">Неактивная галочка</Label>
    </div>
</div>

<!-- Тест в реальной форме -->
<form class="mt-4">
    <div class="flex items-center gap-3 mb-4">
        <Checkbox name="agree" id="agree" />
        <Label for="agree">Согласен обработать данные</Label>
    </div>
    <Button type="submit">Отправить</Button>
</form>
