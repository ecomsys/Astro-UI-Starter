---
import { RadioGroup, RadioGroupItem } from "../ui/radio-group";
import Label from "../ui/Label.astro";
---

<!-- Группа радио-кнопок -->
<RadioGroup defaultValue="user" class="flex flex-col gap-4">
    <div class="flex items-center gap-3">
        <RadioGroupItem value="admin" id="role-admin" />
        <Label for="role-admin">Администратор (Полный доступ)</Label>
    </div>

    <div class="flex items-center gap-3">
        <RadioGroupItem value="user" id="role-user" />
        <Label for="role-user">Пользователь (Базовый доступ)</Label>
    </div>

    <div class="flex items-center gap-3">
        <RadioGroupItem value="guest" id="role-guest" disabled />
        <Label for="role-guest">Гость (Отключено)</Label>
    </div>
</RadioGroup>
