---
import {
    Pagination,
    PaginationContent,
    PaginationItem,
    PaginationLink,
    PaginationPrevious,
    PaginationNext,
    PaginationEllipsis,
} from "../ui/pagination";
---

<Pagination>
    <PaginationContent>
        <PaginationItem>
            <PaginationPrevious href="#" />
        </PaginationItem>

        <PaginationItem>
            <PaginationLink href="#" isActive>1</PaginationLink>
        </PaginationItem>
        <PaginationItem>
            <PaginationLink href="/page-2">2</PaginationLink>
        </PaginationItem>
        <PaginationItem>
            <PaginationLink href="/page-3">3</PaginationLink>
        </PaginationItem>

        <PaginationItem>
            <PaginationEllipsis />
        </PaginationItem>

        <PaginationItem>
            <PaginationLink href="/page-8">8</PaginationLink>
        </PaginationItem>

        <PaginationItem>
            <PaginationNext href="/page-2" />
        </PaginationItem>
    </PaginationContent>
</Pagination>
