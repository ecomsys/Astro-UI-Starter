---
import { Field, FieldLabel, FieldContent, FieldDescription, FieldError, FieldGroup } from "../ui/field";
import Input from "../ui/Input.astro";
import Button from "../ui/Button.astro";
---

<FieldGroup>
    <!-- Поле Email -->
    <Field orientation="horizontal">
        <FieldLabel for="email">Email</FieldLabel>
        <Input id="email" type="email" placeholder="m@example.com" />
        <FieldDescription>Мы никогда не передадим ваш email третьим лицам.</FieldDescription>
    </Field>

    <!-- Поле Пароль с ошибкой -->
    <Field orientation="vertical" invalid={true}>
        <FieldLabel for="password">Пароль</FieldLabel>
        <Input id="password" type="password" placeholder="******" aria-invalid="true" />
        <!-- Выводим ошибку -->
        <FieldError errors={[{ message: "Пароль должен содержать минимум 8 символов" }]} />
    </Field>

    <!-- Адаптивное поле (Чекбокс) -->
    <Field orientation="responsive">
        <FieldLabel for="remember">
            <Input id="remember" type="checkbox" class="peer" />
            Запомнить меня
        </FieldLabel>
        <FieldContent>
            <FieldDescription>Оставаться в системе 30 дней.</FieldDescription>
        </FieldContent>
    </Field>

    <Button class="w-full">Войти</Button>
</FieldGroup>
