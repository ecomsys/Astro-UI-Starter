---
import { HoverCard, HoverCardTrigger, HoverCardContent } from "../ui/hover-card";
import { Avatar, AvatarImage, AvatarFallback } from "../ui/avatar";
import Button from "../ui/Button.astro";
---

<HoverCard side="bottom" align="end" sideOffset={8} delay={150}>
    <HoverCardTrigger>
        <Avatar class="cursor-pointer">
            <AvatarImage src="https://i.pravatar.cc/150?img=12" alt="@ivan" />
            <AvatarFallback>ИВ</AvatarFallback>
        </Avatar>
    </HoverCardTrigger>

    <HoverCardContent class="w-72">
        <!-- Контент карточки -->
        <div class="flex justify-between space-x-4">
            <Avatar>
                <AvatarImage src="https://i.pravatar.cc/150?img=12" alt="@ivan" />
                <AvatarFallback>ИВ</AvatarFallback>
            </Avatar>
            <div class="space-y-1 flex-1">
                <h3 class="text-sm font-medium leading-none">Иван Иванов</h3>
                <p class="text-xs text-muted-foreground">@ivan_dev</p>
                <Button size="xs" class="mt-2 w-full">Подписаться</Button>
            </div>
        </div>
        <p class="mt-3 text-xs text-muted-foreground">Фронтенд-разработчик. Пишу про Astro, Tailwind и Alpine.js.</p>
        <div class="mt-3 flex gap-4 text-xs">
            <span><b class="text-foreground">1.2K</b> Подписчиков</span>
            <span><b class="text-foreground">340</b> Записей</span>
        </div>
    </HoverCardContent>
</HoverCard>
