---
import AspectRatio from "../ui/AspectRatio.astro";
---

<div class="bg-background text-foreground flex flex-col gap-8 items-start w-full max-w-2xl">
    <!-- Пропорция 16:9 (Стандартное видео/превью) -->
    <div class="w-full">
        <h3 class="mb-2 text-sm font-medium">16:9 (Видео)</h3>
        <AspectRatio ratio={16 / 9} class="overflow-hidden rounded-xl bg-muted">
            <img
                src="https://images.unsplash.com/photo-1518791841217-8f162f1e1131?w=600&q=80"
                alt="Cat"
                class="absolute inset-0 h-full w-full object-cover"
            />
        </AspectRatio>
    </div>

    <!-- Пропорция 1:1 (Квадратная аватарка) -->
    <div class="w-48">
        <h3 class="mb-2 text-sm font-medium">1:1 (Квадрат)</h3>
        <AspectRatio ratio={1 / 1} class="overflow-hidden rounded-xl bg-muted">
            <img
                src="https://images.unsplash.com/photo-1518791841217-8f162f1e1131?w=300&q=80"
                alt="Cat"
                class="absolute inset-0 h-full w-full object-cover"
            />
        </AspectRatio>
    </div>

    <!-- Пропорция 4:3 (Старая школа) -->
    <div class="w-96">
        <h3 class="mb-2 text-sm font-medium">4:3 (Классика)</h3>
        <AspectRatio ratio={4 / 3} class="overflow-hidden rounded-xl bg-muted flex items-center justify-center">
            <span class="text-muted-foreground text-sm">Тут может быть видео плеер</span>
        </AspectRatio>
    </div>
</div>
