---
import { cn } from "../../../lib/utils";

export interface Props {
    defaultValue?: string;
    defaultLabel?: string;
    side?: "top" | "bottom" | "left" | "right";
    align?: "start" | "center" | "end";
    sideOffset?: number;
    class?: string;
    [key: string]: any;
}

const {
    defaultValue = "",
    defaultLabel = "Выберите...",
    side = "bottom",
    align = "start",
    sideOffset = 4,
    class: className,
    ...rest
} = Astro.props;

// Экранируем одинарные кавычки для безопасности в HTML атрибутах
const safeDefault = defaultValue.replace(/'/g, "\\'");
const safeLabel = defaultLabel.replace(/'/g, "\\'");
const safeSide = side.replace(/'/g, "\\'");
const safeAlign = align.replace(/'/g, "\\'");
---

<div
    x-data={`select('${safeDefault}', '${safeLabel}', '${safeSide}', '${safeAlign}', ${sideOffset})`}
    x-on:keydown.escape.window="hide()"
    x-on:scroll.window="instantHide()"
    class={className}
    data-slot="select"
    {...rest}
>
    <slot />
</div>
