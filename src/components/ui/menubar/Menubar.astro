---
import { cn } from "../../../lib/utils";
export interface Props {
    class?: string;
    [key: string]: any;
}
const { class: className, ...rest } = Astro.props;
---

<div
    x-data
    @click.outside="$store.menubar.active = false; $store.menubar.closeAll()"
    class={cn("flex h-8 items-center gap-0.5 rounded-lg border p-[0.1875rem]", className)}
    data-slot="menubar"
    {...rest}
>
    <slot />
</div>
