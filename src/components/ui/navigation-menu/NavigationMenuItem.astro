---
import { cn } from "../../../lib/utils";

export interface Props {
    side?: "top" | "bottom" | "left" | "right";
    align?: "start" | "center" | "end";
    sideOffset?: number;
    class?: string;
    [key: string]: any;
}

const { side = "bottom", align = "start", sideOffset = 8, class: className, ...rest } = Astro.props;
---

<li
    x-data={`navMenu('${side}', '${align}', ${sideOffset})`}
    x-on:mouseenter="show()"
    x-on:mouseleave="hide()"
    x-on:keydown.escape.window="forceHide()"
    class={cn("relative", className)}
    data-slot="navigation-menu-item"
    {...rest}
>
    <slot />
</li>
