---
import { cn } from "../../../lib/utils";
import ProgressTrack from "./ProgressTrack.astro";
import ProgressIndicator from "./ProgressIndicator.astro";

export interface Props {
    class?: string;
    [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
---

<!-- Никаких x-data, просто верстка. Он возьмет value от родителя! -->
<div data-slot="progress" class={cn("flex flex-wrap gap-3", className)} {...rest}>
    <slot />
    <ProgressTrack>
        <ProgressIndicator />
    </ProgressTrack>
</div>
