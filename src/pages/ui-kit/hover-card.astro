---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import ComponentDoc from "../../components/ComponentDoc.astro";
import { HoverCard, HoverCardTrigger, HoverCardContent } from "../../components/ui/hover-card";
import { Avatar, AvatarImage, AvatarFallback } from "../../components/ui/avatar";
import Button from "../../components/ui/Button.astro";
import { CalendarDays } from "@lucide/astro";

const basicCode = `import { HoverCard, HoverCardTrigger, HoverCardContent } from '../../components/ui/hover-card';

<HoverCard>
  <HoverCardTrigger>
    <a href="#" class="text-primary underline underline-offset-4 hover:opacity-80">@virgo_ui</a>
  </HoverCardTrigger>
  <HoverCardContent>
    <div class="flex flex-col gap-1">
      <h4 class="text-sm font-semibold">@virgo_ui</h4>
      <p class="text-sm text-muted-foreground">Официальный аккаунт UI-кита.</p>
    </div>
  </HoverCardContent>
</HoverCard>`;

const profileCode = `import { HoverCard, HoverCardTrigger, HoverCardContent } from '../../components/ui/hover-card';
import { Avatar, AvatarImage, AvatarFallback } from '../../components/ui/avatar';
import Button from '../../components/ui/Button.astro';
import { CalendarDays } from '@lucide/astro';

<HoverCard>
  <HoverCardTrigger>
    <a href="#" class="text-primary underline underline-offset-4 hover:opacity-80">Иван Иванов</a>
  </HoverCardTrigger>
  
  <!-- Ширина карточки ограничена w-72 (18rem) -->
  <HoverCardContent class="w-72">
    <div class="flex justify-between space-x-4">
      <Avatar>
        <AvatarImage src="https://i.pravatar.cc/150?img=12" alt="Иван Иванов" />
        <AvatarFallback>ИВ</AvatarFallback>
      </Avatar>
      <div class="space-y-1 flex-1">
        <h4 class="text-sm font-semibold">Иван Иванов</h4>
        <span class="text-xs text-muted-foreground">@ivan_dev</span>
        <p class="text-sm">Фронтенд-разработчик. Пишу про Astro, Tailwind и Alpine.js.</p>
        <Button size="xs" class="mt-2 w-full">Подписаться</Button>
      </div>
    </div>
    <!-- Подвал с датой -->
    <div class="flex items-center pt-3 mt-3 border-t text-xs text-muted-foreground">
      <CalendarDays class="size-3 mr-2" />
      Регистрация: 12 октября 2023
    </div>
  </HoverCardContent>
</HoverCard>`;

const sidesCode = `import { HoverCard, HoverCardTrigger, HoverCardContent } from '../../components/ui/hover-card';
import Button from '../../components/ui/Button.astro';

<!-- side="top" -->
<HoverCard side="top">
  <HoverCardTrigger><Button variant="outline">Сверху</Button></HoverCardTrigger>
  <HoverCardContent>Карточка сверху</HoverCardContent>
</HoverCard>

<!-- side="bottom" align="start" -->
<HoverCard side="bottom" align="start">
  <HoverCardTrigger><Button variant="outline">Снизу (Старт)</Button></HoverCardTrigger>
  <HoverCardContent>Карточка снизу слева</HoverCardContent>
</HoverCard>`;
---

<DashboardLayout title="Hover Card">
    <div class="flex flex-col gap-10">
        <!-- Заголовок страницы -->
        <div class="flex flex-col gap-2">
            <h1 class="text-3xl font-bold tracking-tight">Hover Card</h1>
            <p class="text-muted-foreground text-lg">
                Всплывающая карточка с богатым контентом при наведении. Умеет переворачиваться, исчезать при скролле и
                имеет задержку закрытия (Hover Intent), чтобы пользователь успел перевести курсор внутрь.
            </p>
        </div>

        <!-- 1. БАЗОВАЯ КАРТОЧКА -->
        <ComponentDoc
            title="Базовая карточка"
            description="Появляется при наведении на ссылку или любой другой элемент."
            code={basicCode}
        >
            <div class="flex justify-center py-8">
                Наведи на профиль: <HoverCard>
                    <HoverCardTrigger>
                        <a href="#" class="text-primary underline underline-offset-4 hover:opacity-80 ml-1">@virgo_ui</a
                        >
                    </HoverCardTrigger>
                    <HoverCardContent>
                        <div class="flex flex-col gap-1">
                            <h4 class="text-sm font-semibold">@virgo_ui</h4>
                            <p class="text-sm text-muted-foreground">Официальный аккаунт UI-кита.</p>
                        </div>
                    </HoverCardContent>
                </HoverCard>
            </div>
        </ComponentDoc>

        <!-- 2. ПРОФИЛЬ ПОЛЬЗОВАТЕЛЯ (ЖИРНЫЙ ПРИМЕР) -->
        <ComponentDoc
            title="Профиль пользователя"
            description="Классический кейс из соцсетей. Переведи курсор на ссылку, а затем медленно на саму карточку — она не закроется, и ты сможешь нажать кнопку 'Подписать'."
            code={profileCode}
        >
            <div class="flex justify-center py-8">
                Наведи на имя: <HoverCard>
                    <HoverCardTrigger>
                        <a href="#" class="text-primary underline underline-offset-4 hover:opacity-80 ml-1"
                            >Иван Иванов</a
                        >
                    </HoverCardTrigger>

                    <HoverCardContent class="w-72">
                        <div class="flex justify-between space-x-4">
                            <Avatar>
                                <AvatarImage src="https://i.pravatar.cc/150?img=12" alt="Иван Иванов" />
                                <AvatarFallback>ИВ</AvatarFallback>
                            </Avatar>
                            <div class="space-y-1 flex-1">
                                <h4 class="text-sm font-semibold">Иван Иванов</h4>
                                <span class="text-xs text-muted-foreground">@ivan_dev</span>
                                <p class="text-sm">Фронтенд-разработчик. Пишу про Astro, Tailwind и Alpine.js.</p>
                                <Button size="xs" class="mt-2 w-full">Подписаться</Button>
                            </div>
                        </div>
                        <div class="flex items-center pt-3 mt-3 border-t text-xs text-muted-foreground">
                            <CalendarDays class="size-3 mr-2" />
                            Регистрация: 12 октября 2023
                        </div>
                    </HoverCardContent>
                </HoverCard>
            </div>
        </ComponentDoc>

        <!-- 3. СТОРОНЫ И ВЫРАВНИВАНИЕ -->
        <ComponentDoc
            title="Стороны и выравнивание"
            description="Как и Поповер, поддерживает пропсы side и align."
            code={sidesCode}
        >
            <div class="flex flex-wrap gap-4 justify-center py-12">
                <HoverCard side="top">
                    <HoverCardTrigger><Button variant="outline">Сверху</Button></HoverCardTrigger>
                    <HoverCardContent>Карточка сверху</HoverCardContent>
                </HoverCard>

                <HoverCard side="bottom" align="start">
                    <HoverCardTrigger><Button variant="outline">Снизу (Старт)</Button></HoverCardTrigger>
                    <HoverCardContent>Карточка снизу слева</HoverCardContent>
                </HoverCard>
            </div>
        </ComponentDoc>
    </div>
</DashboardLayout>
