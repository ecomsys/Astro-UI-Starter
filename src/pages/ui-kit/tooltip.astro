---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import ComponentDoc from "../../components/ComponentDoc.astro";
import { Tooltip, TooltipTrigger, TooltipContent } from "../../components/ui/tooltip";
import Button from "../../components/ui/Button.astro";
import { HelpCircle } from "@lucide/astro";

const basicCode = `import { Tooltip, TooltipTrigger, TooltipContent } from '../../components/ui/tooltip';
import Button from '../../components/ui/Button.astro';

<Tooltip>
  <TooltipTrigger>
    <Button variant="outline">Наведи на меня</Button>
  </TooltipTrigger>
  <TooltipContent>Это простая подсказка!</TooltipContent>
</Tooltip>`;

const sidesCode = `import { Tooltip, TooltipTrigger, TooltipContent } from '../../components/ui/tooltip';
import Button from '../../components/ui/Button.astro';

<!-- По умолчанию side="top" -->
<Tooltip>
  <TooltipTrigger><Button variant="outline">Сверху</Button></TooltipTrigger>
  <TooltipContent>Подсказка сверху</TooltipContent>
</Tooltip>

<Tooltip side="bottom">
  <TooltipTrigger><Button variant="outline">Снизу</Button></TooltipTrigger>
  <TooltipContent>Подсказка снизу</TooltipContent>
</Tooltip>

<Tooltip side="left">
  <TooltipTrigger><Button variant="outline">Слева</Button></TooltipTrigger>
  <TooltipContent>Подсказка слева</TooltipContent>
</Tooltip>

<Tooltip side="right">
  <TooltipTrigger><Button variant="outline">Справа</Button></TooltipTrigger>
  <TooltipContent>Подсказка справа</TooltipContent>
</Tooltip>`;

const offsetCode = `import { Tooltip, TooltipTrigger, TooltipContent } from '../../components/ui/tooltip';
import Button from '../../components/ui/Button.astro';

<!-- По умолчанию sideOffset равен 4px -->
<Tooltip>
  <TooltipTrigger><Button variant="outline">Отступ 4px (дефолт)</Button></TooltipTrigger>
  <TooltipContent>Близко</TooltipContent>
</Tooltip>

<!-- Увеличиваем отступ до 20px -->
<Tooltip sideOffset={20}>
  <TooltipTrigger><Button variant="outline">Отступ 20px</Button></TooltipTrigger>
  <TooltipContent>Далеко</TooltipContent>
</Tooltip>`;

const iconCode = `import { Tooltip, TooltipTrigger, TooltipContent } from '../../components/ui/tooltip';
import Button from '../../components/ui/Button.astro';
import { HelpCircle } from '@lucide/astro';

<!-- Частый кейс: подсказка для иконки-кнопки -->
<Tooltip side="right">
  <TooltipTrigger>
    <Button variant="ghost" size="icon">
      <HelpCircle class="size-4" />
    </Button>
  </TooltipTrigger>
  <TooltipContent>Нажмите сюда для помощи</TooltipContent>
</Tooltip>`;
---

<DashboardLayout title="Tooltip">
    <div class="flex flex-col gap-10">
        <!-- Заголовок страницы -->
        <div class="flex flex-col gap-2">
            <h1 class="text-3xl font-bold tracking-tight">Tooltip</h1>
            <p class="text-muted-foreground text-lg">
                Всплывающая подсказка при наведении курсора. Умеет переворачиваться при нехватке места и исчезает при
                скролле.
            </p>
        </div>

        <!-- 1. БАЗОВЫЙ ТУЛТИП -->
        <ComponentDoc
            title="Базовый тултип"
            description="Появляется при наведении мышки. По умолчанию выезжает сверху."
            code={basicCode}
        >
            <div class="flex justify-center py-8">
                <Tooltip>
                    <TooltipTrigger>
                        <Button variant="outline">Наведи на меня</Button>
                    </TooltipTrigger>
                    <TooltipContent>Это простая подсказка!</TooltipContent>
                </Tooltip>
            </div>
        </ComponentDoc>

        <!-- 2. ВСЕ СТОРОНЫ -->
        <ComponentDoc
            title="Все стороны (Sides)"
            description="Используйте пропс side, чтобы выбрать сторону выезда: top, bottom, left, right."
            code={sidesCode}
        >
            <div class="flex flex-wrap gap-4 justify-center py-12">
                <Tooltip>
                    <TooltipTrigger><Button variant="outline">Сверху</Button></TooltipTrigger>
                    <TooltipContent>Подсказка сверху</TooltipContent>
                </Tooltip>

                <Tooltip side="bottom">
                    <TooltipTrigger><Button variant="outline">Снизу</Button></TooltipTrigger>
                    <TooltipContent>Подсказка снизу</TooltipContent>
                </Tooltip>

                <Tooltip side="left">
                    <TooltipTrigger><Button variant="outline">Слева</Button></TooltipTrigger>
                    <TooltipContent>Подсказка слева</TooltipContent>
                </Tooltip>

                <Tooltip side="right">
                    <TooltipTrigger><Button variant="outline">Справа</Button></TooltipTrigger>
                    <TooltipContent>Подсказка справа</TooltipContent>
                </Tooltip>
            </div>
        </ComponentDoc>

        <!-- 3. ИЗМЕНЕНИЕ ОТСТУПА -->
        <ComponentDoc
            title="Отступ от кнопки (sideOffset)"
            description="Используйте пропс sideOffset (в пикселях), чтобы отдалить или приблизить тултип к элементу."
            code={offsetCode}
        >
            <div class="flex flex-wrap gap-8 justify-center py-12">
                <Tooltip>
                    <TooltipTrigger><Button variant="outline">Отступ 4px (дефолт)</Button></TooltipTrigger>
                    <TooltipContent>Близко</TooltipContent>
                </Tooltip>

                <Tooltip sideOffset={20}>
                    <TooltipTrigger><Button variant="outline">Отступ 20px</Button></TooltipTrigger>
                    <TooltipContent>Далеко</TooltipContent>
                </Tooltip>
            </div>
        </ComponentDoc>

        <!-- 4. ТУЛТИП ДЛЯ ИКОНКИ -->
        <ComponentDoc
            title="Тултип для иконки"
            description="Классический юзкейс: иконка-кнопка с пояснением, что она делает. Подсказка выезжает справа."
            code={iconCode}
        >
            <div class="flex justify-center py-8">
                <Tooltip side="right">
                    <TooltipTrigger>
                        <Button variant="ghost" size="icon">
                            <HelpCircle class="size-4" />
                        </Button>
                    </TooltipTrigger>
                    <TooltipContent>Нажмите сюда для помощи</TooltipContent>
                </Tooltip>
            </div>
        </ComponentDoc>
    </div>
</DashboardLayout>
