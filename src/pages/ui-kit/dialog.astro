---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import ComponentDoc from "../../components/ComponentDoc.astro";
import {
    Dialog,
    DialogTrigger,
    DialogContent,
    DialogHeader,
    DialogTitle,
    DialogDescription,
    DialogFooter,
    DialogClose,
} from "../../components/ui/dialog";
import Button from "../../components/ui/Button.astro";
import Input from "../../components/ui/Input.astro";
import Label from "../../components/ui/Label.astro";
import { Trash2 } from "@lucide/astro";

const basicCode = `import { Dialog, DialogTrigger, DialogContent, DialogHeader, DialogTitle, DialogDescription, DialogFooter } from '../../components/ui/dialog';
import Button from '../../components/ui/Button.astro';

<!-- По умолчанию showCloseButton равно false. Крестика нет. -->
<Dialog>
  <DialogTrigger>
    <Button>Открыть окно</Button>
  </DialogTrigger>
  <DialogContent>
    <DialogHeader>
      <DialogTitle>Создать проект</DialogTitle>
      <DialogDescription>Разверните свой новый проект за одну минуту.</DialogDescription>
    </DialogHeader>
    <DialogFooter>
      <Button variant="outline" x-on:click="open = false">Отмена</Button>
      <Button x-on:click="open = false">Создать</Button>
    </DialogFooter>
  </DialogContent>
</Dialog>`;

const closeButtonCode = `import { Dialog, DialogTrigger, DialogContent, DialogHeader, DialogTitle, DialogDescription } from '../../components/ui/dialog';
import Button from '../../components/ui/Button.astro';

<!-- Передайте showCloseButton={true}, чтобы показать крестик в углу -->
<Dialog>
  <DialogTrigger>
    <Button variant="secondary">Открыть с крестиком</Button>
  </DialogTrigger>
  <DialogContent showCloseButton={true}>
    <DialogHeader>
      <DialogTitle>Окно с крестиком</DialogTitle>
      <DialogDescription>В правом верхнем углу появилась иконка закрытия.</DialogDescription>
    </DialogHeader>
  </DialogContent>
</Dialog>`;

const formCode = `import { Dialog, DialogTrigger, DialogContent, DialogHeader, DialogTitle, DialogDescription, DialogFooter } from '../../components/ui/dialog';
import Button from '../../components/ui/Button.astro';
import Input from '../../components/ui/Input.astro';
import Label from '../../components/ui/Label.astro';

<Dialog>
  <DialogTrigger>
    <Button variant="secondary">Редактировать профиль</Button>
  </DialogTrigger>
  <DialogContent showCloseButton={true}>
    <DialogHeader>
      <DialogTitle>Изменить данные</DialogTitle>
      <DialogDescription>Обновите ваш email и пароль здесь.</DialogDescription>
    </DialogHeader>
    
    <div class="flex flex-col gap-4 py-4">
      <div class="flex flex-col gap-2">
        <Label for="email-d">Email</Label>
        <Input id="email-d" type="email" placeholder="m@example.com" />
      </div>
      <div class="flex flex-col gap-2">
        <Label for="pass-d">Пароль</Label>
        <Input id="pass-d" type="password" />
      </div>
    </div>
    
    <DialogFooter>
      <Button variant="outline" x-on:click="open = false">Отмена</Button>
      <Button x-on:click="open = false">Сохранить</Button>
    </DialogFooter>
  </DialogContent>
</Dialog>`;

const destructiveCode = `import { Dialog, DialogTrigger, DialogContent, DialogHeader, DialogTitle, DialogDescription, DialogFooter } from '../../components/ui/dialog';
import Button from '../../components/ui/Button.astro';
import { Trash2 } from '@lucide/astro';

<Dialog>
  <DialogTrigger>
    <Button variant="destructive"><Trash2 class="size-4" /> Удалить аккаунт</Button>
  </DialogTrigger>
  <DialogContent>
    <DialogHeader>
      <DialogTitle>Удалить аккаунт навсегда?</DialogTitle>
      <DialogDescription>Это действие нельзя отменить. Все ваши данные будут безвозвратно удалены с наших серверов.</DialogDescription>
    </DialogHeader>
    <DialogFooter>
      <Button variant="outline" x-on:click="open = false">Отмена</Button>
      <Button variant="destructive" x-on:click="open = false">Да, удалить</Button>
    </DialogFooter>
  </DialogContent>
</Dialog>`;
---

<DashboardLayout title="Dialog">
    <div class="flex flex-col gap-10">
        <!-- Заголовок страницы -->
        <div class="flex flex-col gap-2">
            <h1 class="text-3xl font-bold tracking-tight">Dialog</h1>
            <p class="text-muted-foreground text-lg">
                Модальное окно, перекрывающее взаимодействие с основным контентом. Использует телепорт в body и
                блокировку скролла фона.
            </p>
        </div>

        <!-- 1. БАЗОВОЕ ОКНО (БЕЗ КРЕСТИКА) -->
        <ComponentDoc
            title="Базовое окно"
            description="По умолчанию крестика закрытия нет. Окно закрывается по клику на фон или кнопками."
            code={basicCode}
        >
            <div class="flex justify-center">
                <Dialog>
                    <DialogTrigger>
                        <Button>Открыть окно</Button>
                    </DialogTrigger>
                    <DialogContent>
                        <DialogHeader>
                            <DialogTitle>Создать проект</DialogTitle>
                            <DialogDescription>Разверните свой новый проект за одну минуту.</DialogDescription>
                        </DialogHeader>
                        <DialogFooter>
                            <Button variant="outline" x-on:click="open = false">Отмена</Button>
                            <Button x-on:click="open = false">Создать</Button>
                        </DialogFooter>
                    </DialogContent>
                </Dialog>
            </div>
        </ComponentDoc>

        <!-- 2. ВКЛЮЧЕНИЕ КРЕСТИКА -->
        <ComponentDoc
            title="Окно с крестиком"
            description="Чтобы показать иконку закрытия в правом верхнем углу, передайте пропс showCloseButton={true}."
            code={closeButtonCode}
        >
            <div class="flex justify-center">
                <Dialog>
                    <DialogTrigger>
                        <Button variant="secondary">Открыть с крестиком</Button>
                    </DialogTrigger>
                    <DialogContent showCloseButton={true}>
                        <DialogHeader>
                            <DialogTitle>Окно с крестиком</DialogTitle>
                            <DialogDescription>В правом верхнем углу появилась иконка закрытия.</DialogDescription>
                        </DialogHeader>
                    </DialogContent>
                </Dialog>
            </div>
        </ComponentDoc>

        <!-- 3. ОКНО С ФОРМОЙ -->
        <ComponentDoc
            title="Окно с формой"
            description="Внутрь DialogContent можно помещать формы. Добавьте класс py-4 для отступов от заголовка."
            code={formCode}
        >
            <div class="flex justify-center">
                <Dialog>
                    <DialogTrigger>
                        <Button variant="secondary">Редактировать профиль</Button>
                    </DialogTrigger>
                    <DialogContent showCloseButton={true}>
                        <DialogHeader>
                            <DialogTitle>Изменить данные</DialogTitle>
                            <DialogDescription>Обновите ваш email и пароль здесь.</DialogDescription>
                        </DialogHeader>

                        <div class="flex flex-col gap-4 py-4">
                            <div class="flex flex-col gap-2">
                                <Label for="email-d">Email</Label>
                                <Input id="email-d" type="email" placeholder="m@example.com" />
                            </div>
                            <div class="flex flex-col gap-2">
                                <Label for="pass-d">Пароль</Label>
                                <Input id="pass-d" type="password" />
                            </div>
                        </div>

                        <DialogFooter>
                            <Button variant="outline" x-on:click="open = false">Отмена</Button>
                            <Button x-on:click="open = false">Сохранить</Button>
                        </DialogFooter>
                    </DialogContent>
                </Dialog>
            </div>
        </ComponentDoc>

        <!-- 4. ОКНО УДАЛЕНИЯ (DESTRUCTIVE) -->
        <ComponentDoc
            title="Подтверждение удаления"
            description="Классический кейс для опасных действий. Кнопка 'Да, удалить' имеет variant='destructive'."
            code={destructiveCode}
        >
            <div class="flex justify-center">
                <Dialog>
                    <DialogTrigger>
                        <Button variant="destructive"><Trash2 class="size-4" /> Удалить аккаунт</Button>
                    </DialogTrigger>
                    <DialogContent>
                        <DialogHeader>
                            <DialogTitle>Удалить аккаунт навсегда?</DialogTitle>
                            <DialogDescription
                                >Это действие нельзя отменить. Все ваши данные будут безвозвратно удалены с наших
                                серверов.</DialogDescription
                            >
                        </DialogHeader>
                        <DialogFooter>
                            <Button variant="outline" x-on:click="open = false">Отмена</Button>
                            <Button variant="destructive" x-on:click="open = false">Да, удалить</Button>
                        </DialogFooter>
                    </DialogContent>
                </Dialog>
            </div>
        </ComponentDoc>
    </div>
</DashboardLayout>
